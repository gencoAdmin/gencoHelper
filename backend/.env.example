# Copy to backend/.env for local development. Values here are loaded by go run.
GENCO_ADDR=127.0.0.1:8080
GENCO_DATA_DIR=../data
GENCO_FRONTEND_DIR=../frontend/dist

# Leave blank to use data/state.json instead of MySQL.
GENCO_MYSQL_DSN=
GENCO_MIGRATION_DSN=

# Google Cloud Storage for uploads (product images + staged import workbooks).
# GENCO_GCS_CREDENTIALS_FILE points at a downloaded service-account JSON key.
# GENCO_GCS_PREFIX (optional) namespaces objects so one bucket can host many apps.
GENCO_GCS_BUCKET=
GENCO_GCS_CREDENTIALS_FILE=
GENCO_GCS_PREFIX=
