GENCO_ADDR=127.0.0.1:8080
GENCO_MYSQL_DSN=genco_runtime:CHANGE_ME@tcp(127.0.0.1:3306)/genco_finance?parseTime=true&charset=utf8mb4&loc=UTC
GENCO_DATA_DIR=/var/lib/genco-finance
GENCO_FRONTEND_DIR=/opt/genco-finance/current/frontend/dist
GENCO_PUBLIC_URL=https://finance.example.com

# Google Cloud Storage for uploads (product images + staged import workbooks).
GENCO_GCS_BUCKET=genco-finance-uploads
GENCO_GCS_CREDENTIALS_FILE=/etc/genco-finance/gcs-service-account.json
GENCO_GCS_PREFIX=
